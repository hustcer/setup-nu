{
  "name": "setup-nu",
  "version": "3.30.0",
  "private": true,
  "description": "A Github Action to Setup a Nushell Environment to Run Nu Scripts or Commands",
  "homepage": "https://github.com/hustcer/setup-nu#readme",
  "bugs": {
    "url": "https://github.com/hustcer/setup-nu/issues"
  },
  "license": "MIT",
  "author": "hustcer <hustcer@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hustcer/setup-nu.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "fmt": "oxfmt --write .",
    "lint": "oxlint .",
    "test": "nu nu/test.nu",
    "build": "nu nu/build.nu",
    "run": "pnpm run build && RUNNER_TOOL_CACHE=./runner/cache RUNNER_TEMP=./runner/temp node dist/index.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/rest": "^22.0.1",
    "globby": "^16.2.4",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "cspell": "^10.4.1",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "semver": "^7.8.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12"
  },
  "actionVer": "v3.30"
}
